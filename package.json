{
  "name": "cesium-wind-layer-3d",
  "version": "0.1.2",
  "description": "A WebGL2 GPU-accelerated 3D wind field layer for CesiumJS, using 3D textures and particle advection.",
  "type": "module",
  "main": "./dist/cesium-wind-layer-3d.cjs",
  "module": "./dist/cesium-wind-layer-3d.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/cesium-wind-layer-3d.js",
      "require": "./dist/cesium-wind-layer-3d.cjs"
    }
  },
  "files": [
    "dist",
    "types",
    "src"
  ],
  "scripts": {
    "build": "vite build && node build-package.js",
    "build:lib": "vite build",
    "dev": "vite --config example/vite.config.js",
    "local:server": "py tools/server/local_service.py",
    "convert:server": "py tools/server/local_service.py",
    "terrain:build": "py tools/terrain/build_quantized_mesh.py",
    "test": "vitest run"
  },
  "keywords": [
    "cesium",
    "cesiumjs",
    "wind",
    "wind-field",
    "3d",
    "webgl2",
    "particles",
    "gpgpu"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lby0101/cesium-wind-layer-3d.git"
  },
  "bugs": {
    "url": "https://github.com/lby0101/cesium-wind-layer-3d/issues"
  },
  "homepage": "https://github.com/lby0101/cesium-wind-layer-3d#readme",
  "license": "MIT",
  "peerDependencies": {
    "cesium": "^1.142.0"
  },
  "devDependencies": {
    "cesium": "^1.142.0",
    "lucide": "^1.47.0",
    "vite": "^7.0.0",
    "vite-plugin-cesium": "^1.2.23",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "netcdfjs": "^4.0.0"
  }
}
