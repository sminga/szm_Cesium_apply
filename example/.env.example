# Browser-visible Cesium ion token. Restrict allowed URLs in the Cesium ion dashboard.
VITE_CESIUM_ION_TOKEN=your_browser_token

# Public-browser basemap configuration. Use provider-authorized HTTPS templates and
# restrict every browser-visible token/key by domain and service scope.
VITE_TIANDITU_TOKEN=
VITE_AMAP_TILE_URL=
VITE_BAIDU_TILE_URL=
VITE_TENCENT_TILE_URL=
VITE_GEOVIS_TILE_URL=
VITE_GEOVIS_TOKEN=

# Local Python/Docker tools are enabled automatically by `npm run dev`.
# Set to true only when a production-like build can reach VITE_LOCAL_SERVICE_URL.
VITE_ENABLE_LOCAL_TOOLS=false
VITE_LOCAL_SERVICE_URL=http://127.0.0.1:8765

# Fireflow distribution UI is disabled by default. Enable it only when the deployed
# page has an approved same-origin HTTPS route for /api/v1/*. A Vercel public page
# must not point this value directly at the laboratory 10.x private address.
VITE_FIREFLOW_ENABLED=false
VITE_FIREFLOW_BASE_URL=
